{
  "name": "@nqbt/monorepo",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write './**/*.{ts,mjs}'",
    "nqbtc": "tsx packages/nqbtc/src/cli.ts",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "bumpp": "latest",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=v24.0.0"
  }
}